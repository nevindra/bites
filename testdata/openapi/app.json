{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "status"
              ],
              "type": "object"
            }
          }
        },
        "description": "An error answer (problem+json)."
      },
      "InvalidInput": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "errors": {
                  "items": {
                    "properties": {
                      "location": {
                        "type": "string"
                      },
                      "max": {
                        "description": "The upper bound of a length, range or items rule. Absent when the rule has no upper bound.",
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "min": {
                        "description": "The lower bound of a length, range or items rule. Absent when the rule has no lower bound.",
                        "type": "integer"
                      },
                      "rule": {
                        "description": "The machine-readable code of the message: type, required, length, range, items, nonempty, positive, values or check. Absent when the message has none.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "location",
                      "message"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "title",
                "status",
                "errors"
              ],
              "type": "object"
            }
          }
        },
        "description": "The request does not fit the route's input: every error found is listed with its location."
      }
    },
    "schemas": {
      "docAdmin": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "docEvent.Request": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "docEvent.Response": {
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "docLogin": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "password"
        ],
        "type": "object"
      },
      "docMsg.Request": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "docMsg.Response": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "docNewUser": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/docRole"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "docPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/docUser"
            },
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "docRole": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      },
      "docUser": {
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "description": "Where mail goes; absent for a user without one.",
            "type": "string"
          },
          "id": {
            "description": "The user's id.",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/docRole"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "created"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The users API.",
    "title": "Users",
    "version": "1.4.0"
  },
