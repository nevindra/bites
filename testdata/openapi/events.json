{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "status"
              ],
              "type": "object"
            }
          }
        },
        "description": "An error answer (problem+json)."
      },
      "InvalidInput": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "errors": {
                  "items": {
                    "properties": {
                      "location": {
                        "type": "string"
                      },
                      "max": {
                        "description": "The upper bound of a length, range or items rule. Absent when the rule has no upper bound.",
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "min": {
                        "description": "The lower bound of a length, range or items rule. Absent when the rule has no lower bound.",
                        "type": "integer"
                      },
                      "rule": {
                        "description": "The machine-readable code of the message: type, required, length, range, items, nonempty, positive, values or check. Absent when the message has none.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "location",
                      "message"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "title",
                "status",
                "errors"
              ],
              "type": "object"
            }
          }
        },
        "description": "The request does not fit the route's input: every error found is listed with its location."
      }
    },
    "schemas": {
      "docNotice": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
