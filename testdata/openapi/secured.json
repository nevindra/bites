{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "status"
              ],
              "type": "object"
            }
          }
        },
        "description": "An error answer (problem+json)."
      },
      "InvalidInput": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "errors": {
                  "items": {
                    "properties": {
                      "location": {
                        "type": "string"
                      },
                      "max": {
                        "description": "The upper bound of a length, range or items rule. Absent when the rule has no upper bound.",
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "min": {
                        "description": "The lower bound of a length, range or items rule. Absent when the rule has no lower bound.",
                        "type": "integer"
                      },
                      "rule": {
                        "description": "The machine-readable code of the message: type, required, length, range, items, nonempty, positive, values or check. Absent when the message has none.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "location",
                      "message"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "title",
                "status",
                "errors"
              ],
              "type": "object"
            }
          }
        },
        "description": "The request does not fit the route's input: every error found is listed with its location."
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "status"
              ],
              "type": "object"
            }
          }
        },
        "description": "The client has made more requests than its rate limit allows.",
        "headers": {
          "RateLimit": {
            "description": "What is left of the limit, and when it resets.",
            "schema": {
              "type": "string"
            }
          },
          "RateLimit-Policy": {
            "description": "The limit's policy: its name, quota and window.",
            "schema": {
              "type": "string"
            }
          },
          "Retry-After": {
            "description": "Seconds until a request will be allowed.",
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "status"
              ],
              "type": "object"
            }
          }
        },
        "description": "The request has no credential of the route's scheme, or one that is not valid.",
        "headers": {
          "WWW-Authenticate": {
            "description": "The challenge: the scheme and realm to authenticate with, and error=\"invalid_token\" for a Bearer token that is not valid.",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "docCaller": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "docEvent.Request": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "docEvent.Response": {
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "apiKeyAuth.X-Tenant-Key": {
        "in": "header",
        "name": "X-Tenant-Key",
        "type": "apiKey"
      },
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "cookieAuth.sid": {
        "in": "cookie",
        "name": "sid",
        "type": "apiKey"
      },
      "mutualTLS": {
        "description": "A client certificate our CA issued.",
        "type": "mutualTLS"
      },
      "openIdConnect": {
        "openIdConnectUrl": "https://id.example.com/.well-known/openid-configuration",
        "type": "openIdConnect"
      }
    }
  },
  "info": {
    "title": "Shop",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
